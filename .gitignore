# MkDocs build output — never commit
site/

# Auto-generated publish directory — rebuilt by publish.sh on every deploy
published/

# Brochure PDFs — generated on publish, not committed
tbs-brochure.pdf
tbs-002-brochure.pdf

# Stale root logo (moved to assets/ in d38ce71)
logo-final.png

# Claude Code session files
.claude/

# Private secrets (API tokens, etc.) — NEVER commit
.env.private
.env.private*
*.swp

# Sketchfab: .dae export artifact (regenerated on each push) + stale marker
models/*.dae
.sketchfab-pushed

# SketchUp auto-save backups (e.g. overview~.skp) — never commit
*~.skp
# scratch standalone corridor view (the combined water.skp is the tracked deliverable)
models/corridor-panel.skp

# Brainstorming visual-companion scratch dir
.superpowers/

# Python Virtual Environment
.venv/

# Generated SketchUp Ruby build scripts — the .rb are a build artifact of their .py generator
# (--save), not a source. The dependencies.yml source_hash (manifest) is their staleness tripwire,
# so they're no longer committed. (archive/*.rb is a frozen historical copy with no generator — kept.)
src/models/*.rb

# Python caches
src/generators/__pycache__/
src/models/__pycache__/

# Downloaded vendor spec sheets / datasheets (reference only — not repo source)
eng-specs/

# Numbers/Excel working copies of the parts worklist (the tracked source is parts-worklist.csv)
parts-worklist.numbers
parts-worklist.xlsx

# Downloaded vendor quotes
quoates/


